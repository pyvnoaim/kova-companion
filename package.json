{
  "name": "kova-companion",
  "version": "2.1.3",
  "private": true,
  "description": "Companion app for KovaaK's: presets, HUD layout and your kova profile, live while the game is open.",
  "author": "pyvnoaim",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/pyvnoaim/kova-companion.git"
  },
  "main": "src/main.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "electron .",
    "lint": "eslint .",
    "core:test": "node src/core/selftest.js && node src/core/selftest-main.js",
    "dist": "electron-builder",
    "release": "node scripts/release.js",
    "release:publish-only": "node scripts/fetch-ffmpeg.js --check && electron-builder --publish always"
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "electron": "^43.1.1",
    "electron-builder": "^26.0.12",
    "eslint": "^10.8.1",
    "globals": "^17.11.0"
  },
  "build": {
    "appId": "app.kova.presets",
    "productName": "kova companion",
    "files": [
      "src/**/*"
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "pyvnoaim",
        "repo": "kova-companion",
        "releaseType": "release"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "src/assets/app.ico",
      "extraResources": [
        {
          "from": "vendor/ffmpeg",
          "to": "ffmpeg",
          "filter": [
            "ffmpeg.exe",
            "LICENSE.md",
            "SOURCE.md"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "shortcutName": "kova companion",
      "uninstallDisplayName": "kova companion",
      "deleteAppDataOnUninstall": false,
      "artifactName": "kova-companion-setup.${ext}"
    }
  }
}
